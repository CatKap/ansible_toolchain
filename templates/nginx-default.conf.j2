user  {{ nginx_user if nginx_user is defined else "www-data" }};                          # or www-data on Debian/Ubuntu

worker_processes  auto;
error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

# Load dynamic modules
include /etc/nginx/modules-enabled/*.conf;

{% if use_jwt is defined %}
  load_module /usr/lib/nginx/modules/ngx_http_auth_jwt_module.so;
{% endif %}

events {
    worker_connections  1024;
    multi_accept        on;
    # use epoll;                      # Linux default, usually auto-detected
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Logging
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    # Performance
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size  2048;

    # Security
    server_tokens  off;               # hide nginx version

    # Gzip
    gzip  on;
    gzip_vary  on;
    gzip_proxied  any;
    gzip_comp_level  6;
    gzip_min_length  1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss
        application/rss+xml
        image/svg+xml
        font/truetype
        font/opentype
        application/vnd.ms-fontobject;

    # Client limits (adjust as needed)
    client_max_body_size  16m;
    client_body_buffer_size  128k;
    client_header_buffer_size  1k;
    large_client_header_buffers  4 8k;

    # Timeouts
    client_header_timeout  15s;
    client_body_timeout    15s;
    send_timeout           15s;

    
    ssl_certificate     /certs/{{ domain }}/fullchain.pem;
    ssl_certificate_key     /certs/{{ domain }}/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;



    # Include virtual hosts / extra configs
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;   # Debian/Ubuntu style
}
